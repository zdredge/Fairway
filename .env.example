# Drizzle / libSQL (SQLite dialect)
# Dev uses a local file; note the required `file:` scheme. Tests use `:memory:`.
DATABASE_URL=file:local.db

# Production (Turso) — set these in the Vercel project's env, not in this file:
#   DATABASE_URL=libsql://<your-db>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create`>
